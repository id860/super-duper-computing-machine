PORT=3000
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
ADMIN_NICK=admin
ADMIN_PASSWORD=replace-with-a-long-password
FEATURE_REGISTRATION=true
FEATURE_CHAT=true
FEATURE_PIXELS=true

# Optional shared infrastructure
POSTGRES_PASSWORD=replace-before-use
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=
REDIS_URL=
# json is the safe fallback; postgres enables world_chunks reads with JSON fallback on errors.
CHUNK_READ_MODE=json
API_RATE_LIMIT=300
# Set to worker only when starting the compose worker profile with REDIS_URL.
AUTOMATION_MODE=inline
AUTOMATION_INTERVAL_MS=60000
